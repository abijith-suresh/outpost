{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["arguments", "options"],
  "properties": {
    "arguments": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "maxItems": 1
        }
      },
      "required": ["id"]
    },
    "options": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "--add": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "--remove": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        }
      },
      "required": []
    }
  }
}
