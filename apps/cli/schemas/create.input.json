{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["arguments", "options"],
  "properties": {
    "arguments": {
      "type": "object",
      "additionalProperties": false,
      "properties": {},
      "required": []
    },
    "options": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "--ticket": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "maxItems": 1
        },
        "--type": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "maxItems": 1
        },
        "--repo": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "--tag": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "--base": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "maxItems": 1
        },
        "--dry-run": {
          "const": true
        }
      },
      "required": ["--ticket", "--type"],
      "anyOf": [
        {
          "properties": {
            "--repo": {}
          },
          "required": ["--repo"]
        },
        {
          "properties": {
            "--tag": {}
          },
          "required": ["--tag"]
        }
      ]
    }
  }
}
