{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "ok": {
          "type": "boolean",
          "enum": [true]
        },
        "command": {
          "type": "string",
          "enum": ["create"]
        },
        "data": {
          "type": "object",
          "properties": {
            "ticket": {
              "type": "string"
            },
            "ticketDirectory": {
              "type": "string"
            },
            "type": {
              "type": "string"
            },
            "branch": {
              "type": "string"
            },
            "dryRun": {
              "type": "boolean"
            },
            "workspacePath": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "worktrees": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "repoId": {
                    "type": "string"
                  },
                  "repoName": {
                    "type": "string"
                  },
                  "path": {
                    "type": "string"
                  },
                  "branch": {
                    "type": "string"
                  },
                  "base": {
                    "type": "string"
                  }
                },
                "required": ["repoId", "repoName", "path", "branch", "base"],
                "additionalProperties": true
              }
            }
          },
          "required": ["ticket", "ticketDirectory", "type", "branch", "dryRun", "worktrees"],
          "additionalProperties": true
        },
        "exitCode": {
          "type": "number",
          "enum": [0]
        }
      },
      "required": ["ok", "command", "data", "exitCode"],
      "additionalProperties": true
    },
    {
      "type": "object",
      "properties": {
        "ok": {
          "type": "boolean",
          "enum": [false]
        },
        "command": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "enum": [
                "GUIDANCE_FAILED",
                "INVALID_ARGUMENT",
                "UNKNOWN_COMMAND",
                "CREATE_FAILED",
                "DOCTOR_FAILED",
                "INIT_FAILED",
                "REPO_ADD_FAILED",
                "REPO_FETCH_FAILED",
                "REPO_LIST_FAILED",
                "REPO_REMOVE_FAILED",
                "REPO_SHOW_FAILED",
                "WORKSPACE_LIST_FAILED",
                "WORKSPACE_REMOVE_FAILED",
                "WORKSPACE_SHOW_FAILED"
              ]
            },
            "message": {
              "type": "string"
            },
            "reason": {
              "type": "string",
              "enum": [
                "lock-held",
                "dirty-worktree",
                "repo-in-use",
                "repo-missing",
                "workspace-missing",
                "invalid-arguments",
                "invalid-state",
                "approval-needed",
                "operation-failed"
              ]
            },
            "retryable": {
              "type": "boolean"
            },
            "action": {
              "type": "string"
            },
            "diagnostics": {
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "stream": {
                        "type": "string",
                        "enum": ["stdout", "stderr"]
                      },
                      "line": {
                        "type": "string"
                      }
                    },
                    "required": ["stream", "line"],
                    "additionalProperties": true
                  }
                },
                {
                  "type": "null"
                }
              ]
            },
            "diagnosticTruncation": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "truncated": {
                      "type": "boolean"
                    },
                    "omittedLineCount": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "capturedOutputTruncated": {
                      "type": "boolean"
                    },
                    "maxLines": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "maxCharacters": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": [
                    "truncated",
                    "omittedLineCount",
                    "capturedOutputTruncated",
                    "maxLines",
                    "maxCharacters"
                  ],
                  "additionalProperties": true
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": ["code", "message", "reason", "retryable", "action"],
          "additionalProperties": true
        },
        "exitCode": {
          "type": "number",
          "enum": [1]
        }
      },
      "required": ["ok", "command", "error", "exitCode"],
      "additionalProperties": true
    }
  ]
}
