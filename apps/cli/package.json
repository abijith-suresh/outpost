{
  "name": "@abijith-suresh/outpost",
  "version": "0.0.26",
  "description": "CLI for managing local repository workspaces.",
  "type": "module",
  "bin": {
    "outpost": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./skills/*": "./skills/*",
    "./man/*": "./man/*",
    "./schemas/*": "./schemas/*"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "skills",
    "man",
    "schemas"
  ],
  "engines": {
    "node": ">=24.19.0 <25",
    "npm": ">=11.5.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abijith-suresh/outpost.git",
    "directory": "apps/cli"
  },
  "homepage": "https://github.com/abijith-suresh/outpost#readme",
  "bugs": {
    "url": "https://github.com/abijith-suresh/outpost/issues"
  },
  "keywords": [
    "cli",
    "developer-tools",
    "typescript"
  ],
  "author": "abijith-suresh",
  "license": "MIT",
  "scripts": {
    "benchmark": "npm run build && node scripts/benchmark.mjs",
    "build": "npm run clean && tsc -p tsconfig.json && node scripts/generate-docs.mjs --check",
    "clean": "node --eval \"fs.rmSync('dist', { force: true, recursive: true })\"",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "test:smoke": "node scripts/smoke.mjs",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "verify": "npm run typecheck && npm run docs:check && npm run test && npm run test:runtime-dependencies",
    "docs:generate": "tsc -p tsconfig.json && node scripts/generate-docs.mjs && tsc -p tsconfig.json",
    "docs:check": "tsc -p tsconfig.json && node scripts/generate-docs.mjs --check",
    "test:runtime-dependencies": "node --test scripts/runtime-dependencies.test.mjs"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.6",
    "@effect/platform-node-shared": "4.0.6",
    "effect": "4.0.6"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "typescript": "7.0.2",
    "vitest": "4.1.12"
  },
  "man": [
    "man/outpost.1"
  ]
}
